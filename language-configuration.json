    },
    "onEnterRules": [
        {
            "beforeText": "^\\s*(?:[Aa]lgoritmo\\b.*|[Pp]roceso\\b.*|[Ff]uncion\\b.*|[Ss]i\\b.*\\bEntonces\\s*|[Mm]ientras\\b.*\\bHacer\\s*|[Pp]ara\\b.*\\bHacer\\s*|[Rr]epetir\\s*)$",
            "afterText": "^\\s*(?:Fin(?:Algoritmo|Proceso|Funcion|Si|Mientras|Para)\\b|Hasta\\s+Que\\b).*$",
            "action": {
                "indent": "indentOutdent"
            }
