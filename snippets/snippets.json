{
	"algoritmo": {
		"prefix": "algoritmo",
		"body": [
			"Algoritmo ${1:nombre}",
			"\t$0",
			"FinAlgoritmo"
		],
		"description": "Inserción de un bloque de algoritmo"
	},
	"para": {
		"prefix": "para",
		"body": [
			"Para ${1:contador} <- ${2:inicio} Hasta ${3:fin} Con Paso ${4:1} Hacer",
			"\t$0",
			"FinPara"
		],
		"description": "Inserción de un bucle Para"
	},
	"repetir": {
		"prefix": "repetir",
		"body": [
			"Repetir",
			"\t$0",
			"Hasta Que ${1:condición}"
		],
		"description": "Inserción de un bucle Repetir-Hasta"
	},
	"mientras": {
		"prefix": "mientras",
		"body": [
			"Mientras (${1:condición}) Hacer",
			"\t$0",
			"FinMientras"
		],
		"description": "Inserción de un bloque de bucle tipo \"mientras\""
	},
	"si": {
		"prefix": "si",
		"body": [
			"Si ${1:condición} Entonces",
			"\t${2:instrucciones}",
			"SiNo",
			"\t${3:instrucciones}",
			"FinSi"
		],
		"description": "Inserción de un bloque \"si\""
	},
	"escribir": {
        "prefix": "escribir",
        "body": [
            "Escribir ${1:mensaje}"
        ],
        "description": "Inserción de un bloque de escritura"
    },    
	"proceso": {
        "prefix": "proceso",
        "body": [
            "Proceso ${1:nombre}(${2:parámetros})",
            "\t$0",
            "FinProceso"
        ],
        "description": "Inserción de un bloque de proceso"
    },
	"leer": {
        "prefix": "leer",
        "body": [
            "Leer ${1:variable}"
        ],
        "description": "Inserción de un bloque de lectura"
    },
	"definir": {
        "prefix": "definir",
        "body": [
            "Definir ${1:variable} Como ${2:tipo}"
        ],
        "description": "Inserción de un bloque de definición de variables"
    }
}