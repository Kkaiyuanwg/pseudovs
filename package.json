{
	"name": "pseudocodigo-es",
	"author": {
		"name": "Kkai"
	},
	"publisher": "Kkai",
	"icon": "logo.png",
	"displayName": "Pseudocódigo",
	"description": "Resaltado de sintaxis y snippets para pseudocódigo en español.",
	"version": "1.0.0",
	"main": "./extension.js",
	"repository": {
		"url": "https://github.com/kkaiyuanwg/pseudovs"
	},
	"activationEvents": [
		"onLanguage:pseudo-es",
		"onCommand:pseudocodigo.runFile"
	],
	"bugs": {
		"url": "https://github.com/kkaiyuanwg/pseudovs/issues"
	},
	"homepage": "https://github.com/kkaiyuanwg/pseudovs#readme",
	"keywords": [
		"pseudocódigo",
		"pseudocode",
		"español",
		"snippets"
	],
	"engines": {
		"vscode": "^1.39.0"
	},
	"scripts": {
		"start": "node src/cli.js",
		"interpreter": "node src/cli.js"
	},
	"bin": {
		"pseudocodigo": "./src/cli.js"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"commands": [
			{
				"command": "pseudocodigo.runFile",
				"title": "Ejecutar pseudocódigo",
				"category": "Pseudocódigo",
				"icon": {
					"light": "./run.svg",
					"dark": "./run.svg"
				}
			}
		],
		"languages": [
			{
				"id": "pseudo-es",
				"aliases": [
					"Pseudocódigo",
					"pseudo-ES",
					"pseudo-ESP"
				],
				"extensions": [
					".algo",
					".alg",
					".pse"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "pseudo-es",
				"scopeName": "source.algo",
				"path": "./syntaxes/pseudocodigo.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "pseudo-es",
				"path": "./snippets/snippets.json"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "pseudocodigo.runFile",
					"when": "editorLangId == pseudo-es && pseudocodigo.codeRunnerAvailable != true",
					"group": "navigation"
				}
			]
		}
	},
	"devDependencies": {
		"vsce": "^2.15.0"
	}
}
