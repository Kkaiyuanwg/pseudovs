{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Pseudocódigo",
	"patterns": [
		{"include": "#keywords"},
		{"include": "#expression"},
		{"include": "#strings"},
		{"include": "#string"},
		{"include": "#numbers"},
		{"include": "#params"}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "comment.line.double-slash",
					"match": "//.*$"
				},
				{
					"name": "comment.block",
					"begin": "\\/\\*",
					"end": "\\*\\/"
				},
				{
					"name": "keyword.control.pseudocode",
					"match": "\\b(?i:(algoritmo|finalgoritmo|proceso|finproceso|funcion|finfuncion|si|entonces|sino|finsi|segun|escoger|caso|de otro modo|finsegun|mientras|finmientras|hacer|para|finpara|repetir|hasta|que|con|paso|desde|esperar|retorne|definir|como|escribir|leer|borrar))\\b"
				},
				{
					"name": "support.function.pseudocode",
					"match": "\\b(?i:(raiz|rc|abs|ln|exp|sen|cos|tan|asen|acos|atan|trunc|redon|azar|aleatorio|longitud|mayusculas|minusculas|subcadenas|concatenar|convertiranumero|convertiratexto))\\b"
				},
				{
					"name": "keyword.operator.assignment.pseudocode",
					"match": "<-|->|:="
				},
				{
					"name": "support.type.pseudocode",
					"match": "\\b(?i:(void|real|entero|caracter|texto|numero|numerico|literal|lógico|logico))\\b"
				},
				{
					"name": "constant.language.boolean.pseudocode",
					"match": "\\b(?i:(verdadero|falso|true|false))\\b"
				},
				{
					"name": "keyword.operator.logical.pseudocode",
					"match": "\\b(?i:(y|o|no))\\b"
				},
				{
					"name": "keyword.operator.word.pseudocode",
					"match": "\\b(?i:(es|distinto de|igual a|mayor que|menor que|mayor o igual que|menor o igual que|es cero|es positivo|es negativo|es par|es impar|es múltiplo de|es multiplo de|es divisible por|mod))\\b"
				},
				{
					"name": "keyword.operator.pseudocode",
					"match": "==|!=|<>|<=|>=|[=<>+*/%&-]"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.pseudocode",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.algo-aix",
					"match": "\\\\."
				}
			]
		},
		"string": {
			"name": "string.quoted.single.pseudocode",
			"begin": "'",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.algo-aix",
					"match": "\\\\."
				}
			]
		},
		"expression": {
			"name": "support.function.pseudocode",
			"match": "fijar"
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.float.pseudocode",
					"match": "\\b[0-9]+\\.[0-9]+\\b"
				},
				{
					"name": "constant.numeric.integer.pseudocode",
					"match": "\\b[0-9]+\\b"
				}
			]
		},
		"params": {
			"name": "variable.parameter.pseudocode",
			"match": "\\b(?i:(in|in_out|out))\\b"
		}
	},
	"scopeName": "source.algo"
}
